#!/usr/bin/env bash
#
# Reads file paths on stdin, one per line. Prints any path whose *name* means it
# should never be committed, with a reason, and exits 1 if it printed anything.
#
# This exists because content scanning cannot catch the most common accident. A
# .env holding DB_PASSWORD=hunter2 and SMTP_PASS=letmein has no distinctive
# token shape and no entropy, so every scanner reports it clean -- verified
# against both gitleaks and betterleaks. The only reliable signal is the name.
set -u

found=0

while IFS= read -r path; do
  [ -n "${path}" ] || continue
  base="${path##*/}"

  # Templates and examples exist to be committed. Encrypted blobs are fine too:
  # sops/ansible-vault/git-crypt output is meant to live in the repo.
  case "${base}" in
    *.example|*.example.*|*.sample|*.template|*.tmpl|*.dist|*.enc|*.gpg|*.asc|*.pub)
      continue
      ;;
  esac

  reason=""
  case "${base}" in
    .env|.env.*|*.env)
      reason="environment file, typically holds credentials" ;;
    .npmrc|.pypirc|.netrc|_netrc|.pgpass|.htpasswd|.dockercfg)
      reason="tool config that stores auth tokens" ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519|id_ecdsa_sk|id_ed25519_sk)
      reason="SSH private key" ;;
    *.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|*.ppk)
      reason="private key or keystore" ;;
    *.tfstate|*.tfstate.*)
      reason="terraform state, stores secrets in plaintext" ;;
    credentials|kubeconfig|.kubeconfig)
      reason="cloud or cluster credentials" ;;
    *service-account*.json|*serviceaccount*.json)
      reason="GCP service account key" ;;
    *.kdbx|*.keychain|*.keychain-db)
      reason="password database" ;;
  esac

  if [ -n "${reason}" ]; then
    printf '  %s -- %s\n' "${path}" "${reason}"
    found=1
  fi
done

exit "${found}"
