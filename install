#!/bin/sh
set -u

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
status=0

link() {
  source=$root/$1
  target=$HOME/$2

  if [ ! -e "$source" ]; then
    printf 'missing  %s\n' "$source" >&2
    status=1
  elif [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    printf 'ok       %s\n' "$target"
  elif [ -e "$target" ] && [ "$(stat -Lf '%d:%i' "$target")" = "$(stat -Lf '%d:%i' "$source")" ]; then
    # Target already resolves to the source (e.g. via a parent directory
    # symlink). Treat as linked rather than a conflict.
    printf 'ok       %s (resolves to source)\n' "$target"
  elif [ -e "$target" ] || [ -L "$target" ]; then
    printf 'conflict %s (move it aside and rerun)\n' "$target" >&2
    status=1
  else
    if mkdir -p "$(dirname -- "$target")" && ln -s "$source" "$target"; then
      printf 'linked   %s\n' "$target"
    else
      status=1
    fi
  fi
}

while IFS='|' read -r source target; do
  link "$source" "$target"
done <<'EOF'
zshrc-ohmyzsh|.zshrc
bashrc|.bashrc
zlogout|.zlogout
git/.gitconfig|.gitconfig
git/.gitignore|.gitignore
git/.gittemplate|.gittemplate
git/.git-commit-template.txt|.git-commit-template.txt
.ackrc|.ackrc
.cobra.yaml|.cobra.yaml
.curlrc|.curlrc
.gemrc|.gemrc
.hgignore|.hgignore
.nanorc|.nanorc
.prettierrc|.prettierrc
.screenrc|.screenrc
.tldrrc|.tldrrc
.tmux.conf|.tmux.conf
.vim|.vim
vimrc|.vimrc
vimpluginrc|.vimpluginrc
coffeelint.json|coffeelint.json
atuin/config.toml|.config/atuin/config.toml
git/betterleaks.toml|.config/betterleaks/betterleaks.toml
.config/bat/config|.config/bat/config
ghostty/config|.config/ghostty/config
ghostty/themes/catppuccin-mocha.conf|.config/ghostty/themes/catppuccin-mocha.conf
helix/config.toml|.config/helix/config.toml
herdr/config.toml|.config/herdr/config.toml
hunk/config.toml|.config/hunk/config.toml
lsd/colors.yaml|.config/lsd/colors.yaml
lsd/config.yaml|.config/lsd/config.yaml
mise/config.toml|.config/mise/config.toml
nvim|.config/nvim
zellij/config.kdl|.config/zellij/config.kdl
wezterm/wezterm.lua|.wezterm.lua
k9s/plugins.yaml|Library/Application Support/k9s/plugins.yaml
themes/abtris.zsh-theme|.oh-my-zsh/custom/themes/abtris.zsh-theme
custom/plugins/abtris|.oh-my-zsh/custom/plugins/abtris
EOF

# herdr plugins are fetched from GitHub and built on the machine, so they are
# installed rather than symlinked. Reinstalling the same source is also how
# herdr upgrades a plugin in place, which keeps this idempotent. Set
# DOTFILES_SKIP_HERDR_PLUGINS=1 to skip the network and build work; test-install
# does that so the symlink checks stay fast and offline.
# herdr prints a multi-line install preview even on success, which would bury
# the one-line-per-item output above. Buffer it and replay it only on failure,
# so real errors still reach the terminal.
herdr_plugin() {
  if herdr plugin install "$1" --yes >"$plugin_log" 2>&1; then
    printf 'plugin   %s\n' "$1"
  else
    printf 'failed   %s\n' "$1" >&2
    cat "$plugin_log" >&2
    status=1
  fi
}

if [ "${DOTFILES_SKIP_HERDR_PLUGINS:-0}" = 1 ]; then
  printf 'skipped  herdr plugins (DOTFILES_SKIP_HERDR_PLUGINS)\n'
elif ! command -v herdr >/dev/null; then
  printf 'skipped  herdr plugins (herdr not installed)\n'
else
  plugin_log=$(mktemp)
  trap 'rm -f "$plugin_log"' EXIT
  while read -r plugin; do
    herdr_plugin "$plugin"
  done <<'EOF'
abtris/herdr-plugin-jira-pr
cloudmanic/herdr-plus
nytafar/herdr-cache-ttl
EOF
fi

exit "$status"
